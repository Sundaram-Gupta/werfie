generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Ad {
  id              String   @id
  campaign_id     String
  ad_name         String
  status          String   @default("active")
  ad_type         String
  primary_text    String
  headline        String?
  media_url       String?
  thumbnail_url   String?
  cta_type        String?
  destination_url String?
  impressions     Int      @default(0)
  clicks          Int      @default(0)
  spend           Float    @default(0.0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime
  Campaign        Campaign @relation(fields: [campaign_id], references: [id], onDelete: Cascade)
}

model AdAccount {
  id              String          @id
  businessId      String
  status          String          @default("active")
  currency        String          @default("USD")
  balance         Float           @default(0.0)
  paymentMethod   String?
  paymentDetails  String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime
  BusinessProfile BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  Campaign        Campaign[]
}

model Announcement {
  id                      String                    @id
  institutionId           String
  title                   String
  content                 String
  category                String
  severityLevel           Int                       @default(1)
  regions                 Json
  attachments             Json
  livestreamUrl           String?
  effectiveDate           DateTime                  @default(now())
  expiryDate              DateTime?
  lockDurationMinutes     Int                       @default(0)
  aiSummary               String?
  immutableHash           String                    @unique
  status                  String                    @default("draft")
  isWorldLeaderPost       Boolean                   @default(false)
  leaderId                String?
  leaderPriorityScore     Int                       @default(0)
  isLive                  Boolean                   @default(false)
  transcriptUrl           String?
  speechVideoUrl          String?
  importanceScore         Float?
  createdBy               String
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime
  crisisId                String?
  CrisisEvent             CrisisEvent?              @relation(fields: [crisisId], references: [id])
  AnnouncementRevision    AnnouncementRevision[]
  AnnouncementTranslation AnnouncementTranslation[]
  MarketSignal            MarketSignal[]
  StructuredComment       StructuredComment[]
}

model AnnouncementRevision {
  id             String       @id
  announcementId String
  version        Int
  editedBy       String
  changes        Json
  timestamp      DateTime     @default(now())
  Announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
}

model AnnouncementTranslation {
  id             String       @id
  announcementId String
  languageCode   String
  title          String
  content        String
  status         String       @default("pending")
  aiModelUsed    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  Announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([announcementId, languageCode])
}

model ApiKey {
  id          String    @id
  name        String
  keyHash     String    @unique
  keyPrefix   String
  environment String    @default("dev")
  scopes      String[]
  rateLimit   Int       @default(100)
  status      String    @default("active")
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime

  @@index([keyHash])
}

model Article {
  id          String   @id
  userId      String
  title       String
  content     String
  coverImage  String?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  User        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId])
}

model AuditLog {
  id         String   @id
  adminId    String
  action     String
  targetType String?
  targetId   String?
  details    String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([createdAt])
}

model Bookmark {
  id        String   @id
  postId    String
  userId    String
  createdAt DateTime @default(now())
  Post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model BroadcastNotification {
  id         String   @id
  title      String
  message    String
  targetType String   @default("all")
  authorId   String
  status     String   @default("sent")
  metrics    String?
  createdAt  DateTime @default(now())
}

model BusinessCTA {
  id              String          @id
  businessId      String
  type            String
  label           String
  url             String
  createdAt       DateTime        @default(now())
  BusinessProfile BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model BusinessMember {
  id              String          @id
  businessId      String
  userId          String
  role            String          @default("member")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime
  BusinessProfile BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  User            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
}

model BusinessProfile {
  id                  String           @id
  userId              String           @unique
  companyName         String
  industry            String?
  location            String?
  website             String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime
  isVerified          Boolean          @default(false)
  status              String           @default("pending")
  totalImpressions    String           @default("0")
  totalSpent          String           @default("0")
  verificationDoc     String?
  onboardingCompleted Boolean          @default(false)
  AdAccount           AdAccount[]
  BusinessCTA         BusinessCTA[]
  BusinessMember      BusinessMember[]
  User                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  BusinessReview      BusinessReview[]
  Product             Product[]
}

model BusinessReview {
  id              String          @id
  businessId      String
  userId          String
  rating          Int
  comment         String?
  createdAt       DateTime        @default(now())
  BusinessProfile BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  User            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model Campaign {
  id          String    @id
  adAccountId String
  name        String
  type        String
  status      String    @default("draft")
  dailyBudget Float
  totalBudget Float?
  startTime   DateTime
  endTime     DateTime?
  targeting   String?
  impressions Int       @default(0)
  clicks      Int       @default(0)
  spend       Float     @default(0.0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  Ad          Ad[]
  AdAccount   AdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
}

model CommentModerationQueue {
  id                String            @id
  commentId         String
  reviewerId        String?
  reviewStatus      String            @default("pending")
  notes             String?
  reviewedAt        DateTime?
  createdAt         DateTime          @default(now())
  StructuredComment StructuredComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
}

model CommentReport {
  id                String            @id
  commentId         String
  reporterId        String
  reason            String
  status            String            @default("open")
  createdAt         DateTime          @default(now())
  StructuredComment StructuredComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
}

model Community {
  id                 String               @id
  name               String
  description        String
  avatar             String?
  banner             String?
  membersCount       String
  createdAt          DateTime             @default(now())
  updatedAt          DateTime
  rules              Json?
  CommunityMember    CommunityMember[]
  CommunityModerator CommunityModerator[]
  CommunityPost      CommunityPost[]

  @@index([createdAt])
}

model CommunityMember {
  id          String    @id
  userId      String
  communityId String
  joinedAt    DateTime  @default(now())
  Community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  User        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, communityId])
  @@index([communityId])
  @@index([userId])
}

model CommunityModerator {
  id          String    @id
  userId      String
  communityId String
  Community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  User        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, communityId])
  @@index([communityId])
  @@index([userId])
}

model CommunityPost {
  id          String    @id
  communityId String
  postId      String
  Community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  Post        Post      @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([communityId, postId])
  @@index([communityId])
}

model Conversation {
  id                                           String                    @id
  type                                         String                    @default("direct")
  updatedAt                                    DateTime
  lastMessageAt                                DateTime                  @default(now())
  lastMessageId                                String?                   @unique
  Message_Conversation_lastMessageIdToMessage  Message?                  @relation("Conversation_lastMessageIdToMessage", fields: [lastMessageId], references: [id])
  ConversationUserSetting                      ConversationUserSetting[]
  Message_Message_conversationIdToConversation Message[]                 @relation("Message_conversationIdToConversation")
  Participant                                  Participant[]
}

model ConversationUserSetting {
  id               String       @id
  conversationId   String
  userId           String
  disappearingMode String       @default("off")
  blockScreenshots Boolean      @default(false)
  blockMessages    Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime
  Conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  User             User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
}

model CrisisEvent {
  id                    String         @id
  title                 String
  description           String
  region                String
  country               String
  latitude              Float
  longitude             Float
  severity              Int            @default(1)
  status                String         @default("active")
  linkedAnnouncementIds String[]       @default([])
  startTime             DateTime       @default(now())
  lastUpdateTime        DateTime       @default(now())
  createdBy             String
  createdAt             DateTime       @default(now())
  Announcement          Announcement[]
  CrisisStream          CrisisStream[]
  CrisisUpdate          CrisisUpdate[]
}

model CrisisStream {
  id          String      @id
  crisisId    String
  streamUrl   String
  platform    String
  isLive      Boolean     @default(true)
  startedAt   DateTime    @default(now())
  CrisisEvent CrisisEvent @relation(fields: [crisisId], references: [id], onDelete: Cascade)
}

model CrisisUpdate {
  id             String      @id
  crisisId       String
  announcementId String?
  updateText     String
  timestamp      DateTime    @default(now())
  createdBy      String
  CrisisEvent    CrisisEvent @relation(fields: [crisisId], references: [id], onDelete: Cascade)
}

model DebateArgument {
  id              String            @id
  roundId         String
  speakerId       String
  argumentText    String
  timestamp       DateTime          @default(now())
  factCheckRefs   Json?
  createdAt       DateTime          @default(now())
  DebateRound     DebateRound       @relation(fields: [roundId], references: [id], onDelete: Cascade)
  DebateFactCheck DebateFactCheck[]
}

model DebateFactCheck {
  id                 String         @id
  argumentId         String
  referenceTitle     String
  referenceUrl       String?
  reviewerId         String?
  verificationStatus String         @default("pending")
  notes              String?
  DebateArgument     DebateArgument @relation(fields: [argumentId], references: [id], onDelete: Cascade)
}

model DebateRound {
  id             String           @id
  sessionId      String
  roundNumber    Int
  speakerId      String
  startTime      DateTime?
  endTime        DateTime?
  status         String           @default("pending")
  DebateArgument DebateArgument[]
  DebateSession  DebateSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, roundNumber, speakerId])
}

model DebateSession {
  id                   String        @id
  title                String
  topic                String
  participantAId       String
  participantBId       String
  moderatorId          String?
  startTime            DateTime?
  endTime              DateTime?
  roundDurationMinutes Int           @default(5)
  totalRounds          Int           @default(3)
  status               String        @default("scheduled")
  transcriptText       String?
  aiSummary            String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime
  DebateRound          DebateRound[]
  DebateVote           DebateVote[]
}

model DebateVote {
  id            String        @id
  sessionId     String
  userId        String
  voteChoice    String
  submittedAt   DateTime      @default(now())
  DebateSession DebateSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
}

model EnterpriseAlertLog {
  id                  String              @id
  ruleId              String
  signalId            String
  triggeredAt         DateTime            @default(now())
  deliveryStatus      String              @default("pending")
  EnterpriseAlertRule EnterpriseAlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  MarketSignal        MarketSignal        @relation(fields: [signalId], references: [id], onDelete: Cascade)
}

model EnterpriseAlertRule {
  id                 String               @id
  userId             String
  categories         Json?
  regions            Json?
  severityThreshold  Int                  @default(0)
  impactThreshold    Int                  @default(50)
  keywords           Json?
  deliveryMethod     String               @default("web")
  createdAt          DateTime             @default(now())
  EnterpriseAlertLog EnterpriseAlertLog[]
  User               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EnterpriseUser {
  id               String   @id
  organizationName String
  userId           String   @unique
  subscriptionTier String   @default("standard")
  apiAccessEnabled Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime
  User             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Follow {
  id                            String   @id
  followerId                    String
  followingId                   String
  createdAt                     DateTime @default(now())
  User_Follow_followerIdToUser  User     @relation("Follow_followerIdToUser", fields: [followerId], references: [id], onDelete: Cascade)
  User_Follow_followingIdToUser User     @relation("Follow_followingIdToUser", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

model HiddenMessage {
  id        String   @id
  messageId String
  userId    String
  createdAt DateTime @default(now())
  Message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
}

model Highlight {
  id         String   @id
  userId     String
  postId     String
  createdAt  DateTime @default(now())
  orderIndex Int      @default(0)
  Post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  User       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
}

model InstitutionalProfile {
  id                   String        @id
  userId               String        @unique
  institutionName      String
  institutionType      String
  country              String?
  state                String?
  website              String?
  officialEmailDomain  String?
  description          String?
  logoUrl              String?
  bannerUrl            String?
  repFullName          String?
  repJobTitle          String?
  repDepartment        String?
  repOfficialEmail     String?
  repPhone             String?
  repIdUrl             String?
  repLinkedInUrl       String?
  repAuthLetterUrl     String?
  twoFactorEnabled     Boolean       @default(false)
  primaryRole          String        @default("publisher")
  recoveryEmail        String?
  recoveryPhone        String?
  isVerified           Boolean       @default(false)
  isDomainVerified     Boolean       @default(false)
  supportingDocs       Json?
  transparencyAccepted Boolean       @default(false)
  termsAccepted        Boolean       @default(false)
  publicDisplayName    String?
  publicBio            String?
  headquarters         String?
  categories           Json?
  languages            Json?
  status               String        @default("pending")
  adminNotes           String?
  badgeType            String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime
  User                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  WorldLeader          WorldLeader[]
}

model Like {
  id        String   @id
  postId    String
  userId    String
  createdAt DateTime @default(now())
  Post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model List {
  id           String         @id
  ownerId      String
  name         String
  description  String?
  isPrivate    Boolean        @default(false)
  banner       String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime
  avatar       String?
  isPinned     Boolean        @default(false)
  User         User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ListFollower ListFollower[]
  ListMember   ListMember[]

  @@index([ownerId])
}

model ListFollower {
  id         String   @id
  listId     String
  userId     String
  followedAt DateTime @default(now())
  isPinned   Boolean  @default(false)
  List       List     @relation(fields: [listId], references: [id], onDelete: Cascade)
  User       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([listId, userId])
  @@index([listId])
  @@index([userId])
}

model ListMember {
  id      String   @id
  listId  String
  userId  String
  addedAt DateTime @default(now())
  List    List     @relation(fields: [listId], references: [id], onDelete: Cascade)
  User    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([listId, userId])
  @@index([listId])
  @@index([userId])
}

model MarketSignal {
  id                 String               @id
  announcementId     String
  institutionId      String
  category           String
  region             String
  sector             String?
  severity           Int
  impactScore        Int
  volatilityIndex    Float?
  confidenceScore    Int
  detectedKeywords   Json?
  createdAt          DateTime             @default(now())
  EnterpriseAlertLog EnterpriseAlertLog[]
  Announcement       Announcement         @relation(fields: [announcementId], references: [id], onDelete: Cascade)
}

model Message {
  id                                                String            @id
  conversationId                                    String
  senderId                                          String
  content                                           String?
  createdAt                                         DateTime          @default(now())
  duration                                          Int?
  mediaUrl                                          String?
  mimeType                                          String?
  size                                              Int?
  status                                            String            @default("sent")
  thumbnailUrl                                      String?
  type                                              String            @default("text")
  updatedAt                                         DateTime
  replyToId                                         String?
  isForwarded                                       Boolean           @default(false)
  forwardedFromId                                   String?
  isEdited                                          Boolean           @default(false)
  editedAt                                          DateTime?
  Conversation_Conversation_lastMessageIdToMessage  Conversation?     @relation("Conversation_lastMessageIdToMessage")
  HiddenMessage                                     HiddenMessage[]
  Conversation_Message_conversationIdToConversation Conversation      @relation("Message_conversationIdToConversation", fields: [conversationId], references: [id], onDelete: Cascade)
  Message                                           Message?          @relation("MessageToMessage", fields: [replyToId], references: [id])
  other_Message                                     Message[]         @relation("MessageToMessage")
  User                                              User              @relation(fields: [senderId], references: [id])
  MessageReaction                                   MessageReaction[]

  @@index([conversationId])
  @@index([createdAt])
  @@index([senderId])
}

model MessageReaction {
  id        String   @id
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())
  Message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
}

model MonetizationProfile {
  id               String             @id
  userId           String             @unique
  status           String             @default("pending")
  balance          Float              @default(0.0)
  lifetimeEarnings Float              @default(0.0)
  payoutMethod     String?
  payoutDetails    String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  User             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  SubscriptionTier SubscriptionTier[]
  Transaction      Transaction[]
}

model Notification {
  id                              String   @id
  userId                          String
  type                            String
  actorId                         String
  postId                          String?
  read                            Boolean  @default(false)
  createdAt                       DateTime @default(now())
  User_Notification_actorIdToUser User     @relation("Notification_actorIdToUser", fields: [actorId], references: [id], onDelete: Cascade)
  Post                            Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  User_Notification_userIdToUser  User     @relation("Notification_userIdToUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([actorId])
  @@index([createdAt])
  @@index([userId])
}

model Participant {
  id             String       @id
  userId         String
  conversationId String
  lastReadAt     DateTime     @default(now())
  clearedAt      DateTime?
  Conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  User           User         @relation(fields: [userId], references: [id])

  @@unique([userId, conversationId])
  @@index([userId])
}

model Post {
  id             String          @id
  userId         String
  content        String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime
  replyToId      String?
  mediaUrls      String?
  scheduledAt    DateTime?
  ctaLabel       String?
  ctaLink        String?
  isPinned       Boolean         @default(false)
  productId      String?
  bookmarksCount Int             @default(0)
  likesCount     Int             @default(0)
  repliesCount   Int             @default(0)
  retweetsCount  Int             @default(0)
  Bookmark       Bookmark[]
  CommunityPost  CommunityPost[]
  Highlight      Highlight[]
  Like           Like[]
  Notification   Notification[]
  Product        Product?        @relation(fields: [productId], references: [id])
  Post           Post?           @relation("PostToPost", fields: [replyToId], references: [id], onDelete: Cascade)
  other_Post     Post[]          @relation("PostToPost")
  User           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  PostMedia      PostMedia[]
  Retweet        Retweet[]
  SeenPost       SeenPost[]

  @@index([createdAt])
  @@index([replyToId])
  @@index([scheduledAt])
  @@index([userId, createdAt(sort: Desc)])
}

model PostMedia {
  id           String   @id
  postId       String
  mediaType    String
  mediaUrl     String
  thumbnailUrl String?
  width        Int
  height       Int
  duration     Float?
  size         Int
  createdAt    DateTime @default(now())
  Post         Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model Product {
  id              String          @id
  businessId      String
  name            String
  description     String?
  price           Float?
  currency        String          @default("USD")
  imageUrl        String?
  ctaUrl          String?
  active          Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime
  Post            Post[]
  BusinessProfile BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model Profile {
  id        String    @id
  userId    String    @unique
  name      String
  handle    String    @unique
  bio       String?
  avatar    String?
  banner    String?
  location  String?
  website   String?
  birthdate DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime
  verified  Boolean   @default(false)
  User      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([handle])
}

model PushConfig {
  id           String   @id
  provider     String
  credentials  String
  enabled      Boolean  @default(true)
  allowedTypes String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime
}

model PushTemplate {
  id        String   @id
  name      String   @unique
  title     String
  body      String
  category  String   @default("system")
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model RefreshToken {
  id        String   @id
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Report {
  id         String   @id
  type       String   @default("report")
  targetId   String
  targetType String
  reporterId String
  reason     String?
  status     String   @default("pending")
  createdAt  DateTime @default(now())
  updatedAt  DateTime
  User       User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([reporterId])
  @@index([status])
  @@index([targetId])
}

model Retweet {
  id        String   @id
  postId    String
  userId    String
  createdAt DateTime @default(now())
  Post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model SeenPost {
  id        String   @id
  userId    String
  postId    String
  createdAt DateTime @default(now())
  Post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId, createdAt])
}

model SoapboxRebuttal {
  id               String         @id
  sessionId        String
  institutionId    String
  userId           String
  rebuttalText     String
  moderationStatus String         @default("pending")
  submittedAt      DateTime       @default(now())
  SoapboxSession   SoapboxSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model SoapboxSession {
  id               String             @id
  institutionId    String
  leaderId         String?
  title            String
  description      String
  startTime        DateTime
  durationMinutes  Int
  countdownEndTime DateTime?
  status           String             @default("scheduled")
  transcriptText   String?
  aiSummary        String?
  videoUrl         String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  SoapboxRebuttal  SoapboxRebuttal[]
  SoapboxStatement SoapboxStatement[]
}

model SoapboxStatement {
  id             String         @id
  sessionId      String
  speakerId      String
  content        String
  timestamp      DateTime       @default(now())
  sequenceOrder  Int
  SoapboxSession SoapboxSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model Space {
  id          String    @id
  title       String
  hostId      String
  isLive      Boolean   @default(false)
  time        String?
  createdAt   DateTime  @default(now())
  endedAt     DateTime?
  privacy     String    @default("public")
  scheduledAt DateTime?
  startedAt   DateTime?
  status      String    @default("live")
  topics      String[]
  updatedAt   DateTime
  User        User      @relation(fields: [hostId], references: [id], onDelete: Cascade)

  @@index([hostId])
  @@index([isLive])
  @@index([status])
}

model StructuredComment {
  id                      String                   @id
  announcementId          String
  userId                  String
  parentCommentId         String?
  content                 String
  factFlag                Boolean                  @default(false)
  credibilityScore        Int?
  moderationStatus        String                   @default("pending")
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime
  CommentModerationQueue  CommentModerationQueue[]
  CommentReport           CommentReport[]
  Announcement            Announcement             @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  StructuredComment       StructuredComment?       @relation("StructuredCommentToStructuredComment", fields: [parentCommentId], references: [id])
  other_StructuredComment StructuredComment[]      @relation("StructuredCommentToStructuredComment")
}

model Subscription {
  id                 String           @id
  tierId             String
  subscriberId       String
  status             String           @default("active")
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  createdAt          DateTime         @default(now())
  updatedAt          DateTime
  User               User             @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  SubscriptionTier   SubscriptionTier @relation(fields: [tierId], references: [id], onDelete: Cascade)
  Transaction        Transaction[]
}

model SubscriptionTier {
  id                    String              @id
  monetizationProfileId String
  name                  String
  description           String?
  price                 Float
  perks                 String?
  isActive              Boolean             @default(true)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime
  Subscription          Subscription[]
  MonetizationProfile   MonetizationProfile @relation(fields: [monetizationProfileId], references: [id], onDelete: Cascade)
}

model Transaction {
  id                    String               @id
  monetizationProfileId String?
  subscriptionId        String?
  type                  String
  amount                Float
  currency              String               @default("USD")
  status                String               @default("completed")
  processorId           String?
  createdAt             DateTime             @default(now())
  MonetizationProfile   MonetizationProfile? @relation(fields: [monetizationProfileId], references: [id])
  Subscription          Subscription?        @relation(fields: [subscriptionId], references: [id])
}

model Trend {
  id        String   @id
  category  String
  topic     String
  posts     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime

  @@index([category])
  @@index([createdAt])
}

model User {
  id                                      String                    @id
  email                                   String                    @unique
  passwordHash                            String
  createdAt                               DateTime                  @default(now())
  updatedAt                               DateTime
  preferredLanguage                       String                    @default("en")
  lastActiveAt                            DateTime                  @default(now())
  role                                    String                    @default("USER")
  status                                  String                    @default("ACTIVE")
  institutionType                         String?
  Article                                 Article[]
  Bookmark                                Bookmark[]
  BusinessMember                          BusinessMember[]
  BusinessProfile                         BusinessProfile?
  BusinessReview                          BusinessReview[]
  CommunityMember                         CommunityMember[]
  CommunityModerator                      CommunityModerator[]
  ConversationUserSetting                 ConversationUserSetting[]
  EnterpriseAlertRule                     EnterpriseAlertRule[]
  EnterpriseUser                          EnterpriseUser?
  Follow_Follow_followerIdToUser          Follow[]                  @relation("Follow_followerIdToUser")
  Follow_Follow_followingIdToUser         Follow[]                  @relation("Follow_followingIdToUser")
  HiddenMessage                           HiddenMessage[]
  Highlight                               Highlight[]
  InstitutionalProfile                    InstitutionalProfile?
  Like                                    Like[]
  List                                    List[]
  ListFollower                            ListFollower[]
  ListMember                              ListMember[]
  Message                                 Message[]
  MessageReaction                         MessageReaction[]
  MonetizationProfile                     MonetizationProfile?
  Notification_Notification_actorIdToUser Notification[]            @relation("Notification_actorIdToUser")
  Notification_Notification_userIdToUser  Notification[]            @relation("Notification_userIdToUser")
  Participant                             Participant[]
  Post                                    Post[]
  Profile                                 Profile?
  RefreshToken                            RefreshToken[]
  Report                                  Report[]
  Retweet                                 Retweet[]
  SeenPost                                SeenPost[]
  Space                                   Space[]
  VerificationRequest                     VerificationRequest[]
  chatSettings                            ChatSetting[]         @relation("UserChatSettings")
  targetChatSettings                      ChatSetting[]         @relation("TargetChatSettings")
}

model VerificationRequest {
  id        String   @id
  userId    String
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
}

model WorldLeader {
  id                   String               @id
  institutionId        String
  leaderName           String
  title                String
  profileImage         String?
  region               String
  country              String
  priorityRank         Int                  @default(0)
  autoPushEnabled      Boolean              @default(false)
  verifiedStatus       Boolean              @default(false)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime
  InstitutionalProfile InstitutionalProfile @relation(fields: [institutionId], references: [id], onDelete: Cascade)
}

model ChatSetting {
  id               String   @id @default(uuid())
  userId           String
  targetUserId     String
  isBlocked        Boolean  @default(false)
  isMuted          Boolean  @default(false)
  disappearingMode String   @default("off")
  screenshotBlock  Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  User             User     @relation("UserChatSettings", fields: [userId], references: [id], onDelete: Cascade)
  TargetUser       User     @relation("TargetChatSettings", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@unique([userId, targetUserId])
  @@index([userId])
  @@index([targetUserId])
}
