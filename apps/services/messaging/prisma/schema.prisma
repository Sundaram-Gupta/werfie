generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String                @id @default(uuid())
  email                  String                @unique
  passwordHash           String
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  role                   String                @default("USER")
  status                 String                @default("ACTIVE")
  lastActiveAt           DateTime              @default(now())
  preferredLanguage      String                @default("en")
  institutionType        String?
  adCampaigns            AdCampaign[]
  Bookmark               Bookmark[]
  businessProfile        BusinessProfile?
  communityMemberships   CommunityMember[]
  moderatedCommunities   CommunityModerator[]
  followers              Follow[]              @relation("UserFollowers")
  following              Follow[]              @relation("UserFollowing")
  InstitutionalProfile   InstitutionalProfile?
  likes                  Like[]
  ownedLists             List[]
  followedLists          ListFollower[]
  listMemberships        ListMember[]
  messagesSent           Message[]
  triggeredNotifications Notification[]        @relation("NotificationActor")
  notifications          Notification[]        @relation("NotificationRecipient")
  conversations          Participant[]
  posts                  Post[]
  profile                Profile?
  refreshTokens          RefreshToken[]
  retweets               Retweet[]
  hostedSpaces           Space[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Profile {
  id        String    @id @default(uuid())
  userId    String    @unique
  name      String
  handle    String    @unique
  bio       String?
  avatar    String?
  banner    String?
  location  String?
  website   String?
  birthdate DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  verified  Boolean   @default(false)
  gender    String?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([handle])
}

model Post {
  id             String          @id @default(uuid())
  userId         String
  content        String
  mediaUrls      String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  replyToId      String?
  scheduledAt    DateTime?
  Bookmark       Bookmark[]
  communityPosts CommunityPost[]
  likes          Like[]
  Media          Media[]
  notifications  Notification[]
  replyTo        Post?           @relation("PostReplies", fields: [replyToId], references: [id], onDelete: Cascade)
  replies        Post[]          @relation("PostReplies")
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  media          PostMedia[]
  retweets       Retweet[]

  @@index([userId])
  @@index([replyToId])
  @@index([createdAt])
}

model PostMedia {
  id           String   @id @default(uuid())
  postId       String
  mediaType    String
  mediaUrl     String
  thumbnailUrl String?
  width        Int      @default(0)
  height       Int      @default(0)
  duration     Float?
  size         Int      @default(0)
  createdAt    DateTime @default(now())
  post         Post     @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([postId])
}

model Like {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model Retweet {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  actorId   String
  postId    String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  actor     User     @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([actorId])
  @@index([createdAt])
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("UserFollowers", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

model Trend {
  id        String   @id @default(uuid())
  category  String
  topic     String
  posts     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([createdAt])
}

model Conversation {
  id            String        @id @default(uuid())
  type          String        @default("direct")
  lastMessageId String?
  updatedAt     DateTime      @updatedAt
  messages      Message[]     @relation("ConversationMessages")
  participants  Participant[]
}

model Participant {
  id             String       @id @default(uuid())
  userId         String
  conversationId String
  lastReadAt     DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@unique([userId, conversationId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  type           String       @default("text")
  mediaUrl       String?
  thumbnailUrl   String?
  duration       Float?
  size           Int?
  mimeType       String?
  status         String       @default("sent")
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation("ConversationMessages", fields: [conversationId], references: [id])
  sender         User         @relation(fields: [senderId], references: [id])

  @@index([conversationId])
  @@index([createdAt])
}

model Community {
  id           String               @id @default(uuid())
  name         String
  description  String
  avatar       String?
  banner       String?
  membersCount String
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  members      CommunityMember[]
  moderators   CommunityModerator[]
  posts        CommunityPost[]

  @@index([createdAt])
}

model CommunityMember {
  id          String    @id @default(uuid())
  userId      String
  communityId String
  joinedAt    DateTime  @default(now())
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, communityId])
  @@index([userId])
  @@index([communityId])
}

model CommunityModerator {
  id          String    @id @default(uuid())
  userId      String
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, communityId])
  @@index([userId])
  @@index([communityId])
}

model CommunityPost {
  id          String    @id @default(uuid())
  communityId String
  postId      String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  post        Post      @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([communityId, postId])
  @@index([communityId])
}

model Space {
  id        String   @id @default(uuid())
  title     String
  hostId    String
  isLive    Boolean  @default(false)
  time      String
  createdAt DateTime @default(now())
  host      User     @relation(fields: [hostId], references: [id], onDelete: Cascade)

  @@index([hostId])
  @@index([isLive])
}

model BusinessProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  companyName String
  industry    String?
  location    String?
  website     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdCampaign {
  id          String   @id @default(uuid())
  userId      String
  name        String
  goal        String
  budget      String
  status      String   @default("Active")
  impressions String   @default("0")
  clicks      String   @default("0")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model List {
  id          String         @id @default(uuid())
  ownerId     String
  name        String
  description String?
  isPrivate   Boolean        @default(false)
  banner      String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  owner       User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  followers   ListFollower[]
  members     ListMember[]

  @@index([ownerId])
}

model ListMember {
  id      String   @id @default(uuid())
  listId  String
  userId  String
  addedAt DateTime @default(now())
  list    List     @relation(fields: [listId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([listId, userId])
  @@index([listId])
  @@index([userId])
}

model ListFollower {
  id         String   @id @default(uuid())
  listId     String
  userId     String
  followedAt DateTime @default(now())
  list       List     @relation(fields: [listId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([listId, userId])
  @@index([listId])
  @@index([userId])
}

model Bookmark {
  id        String   @id
  postId    String
  userId    String
  createdAt DateTime @default(now())
  Post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model InstitutionalProfile {
  id                   String   @id
  userId               String   @unique
  institutionName      String
  institutionType      String
  country              String?
  state                String?
  website              String?
  officialEmailDomain  String?
  description          String?
  logoUrl              String?
  bannerUrl            String?
  repFullName          String?
  repJobTitle          String?
  repDepartment        String?
  repOfficialEmail     String?
  repPhone             String?
  repIdUrl             String?
  repLinkedInUrl       String?
  repAuthLetterUrl     String?
  twoFactorEnabled     Boolean  @default(false)
  primaryRole          String   @default("publisher")
  recoveryEmail        String?
  recoveryPhone        String?
  isVerified           Boolean  @default(false)
  isDomainVerified     Boolean  @default(false)
  supportingDocs       Json?
  transparencyAccepted Boolean  @default(false)
  termsAccepted        Boolean  @default(false)
  publicDisplayName    String?
  publicBio            String?
  headquarters         String?
  categories           Json?
  languages            Json?
  status               String   @default("pending")
  adminNotes           String?
  badgeType            String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime
  User                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Media {
  id           String   @id
  postId       String?
  userId       String
  type         String
  url          String
  thumbnailUrl String?
  filename     String
  mimetype     String
  size         Int
  duration     Float?
  width        Int?
  height       Int?
  bitrate      Int?
  status       String   @default("pending")
  error        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime
  Post         Post?    @relation(fields: [postId], references: [id])

  @@index([postId])
  @@index([userId])
}
