                                "like"
                            ]
                        }
                    }
                },
                {
                    "name": "Unlike Post",
                    "request": {
                        "method": "DELETE",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/posts/{{postId}}/like",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "posts",
                                "{{postId}}",
                                "like"
                            ]
                        }
                    }
                },
                {
                    "name": "Retweet Post",
                    "request": {
                        "method": "POST",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/posts/{{postId}}/retweet",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "posts",
                                "{{postId}}",
                                "retweet"
                            ]
                        }
                    }
                },
                {
                    "name": "Unretweet Post",
                    "request": {
                        "method": "DELETE",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/posts/{{postId}}/retweet",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "posts",
                                "{{postId}}",
                                "retweet"
                            ]
                        }
                    }
                },
                {
                    "name": "Get Post Replies",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/posts/{{postId}}/replies",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
