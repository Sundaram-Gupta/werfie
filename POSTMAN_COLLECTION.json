                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "Timeline",
            "item": [
                {
                    "name": "Get Home Timeline",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/timeline/home",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "timeline",
                                "home"
                            ]
                        }
                    }
                }
            ]
        }
    ]
}