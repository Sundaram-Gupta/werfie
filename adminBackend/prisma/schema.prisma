// This is your Prisma schema file
// X-Clone Master Schema (Unified)

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  role          String   @default("USER")
  institutionType String?
  status        String   @default("ACTIVE")
  lastActiveAt  DateTime @default(now())
  preferredLanguage String @default("en")
  
  refreshTokens RefreshToken[]
  profile       Profile?
  
  // Relations from Content/Social
  posts         Post[]
  likes         Like[]
  retweets      Retweet[]
  bookmarks     Bookmark[]
  followers     Follow[]     @relation("UserFollowers")
  following     Follow[]     @relation("UserFollowing")
  notifications Notification[] @relation("NotificationRecipient")
  triggeredNotifications Notification[] @relation("NotificationActor")
  businessReviews        BusinessReview[]
  
  // Highlights & Articles
  highlights    Highlight[]
  articles      Article[]
  
  // Relations from Business & Ads
  businessProfile BusinessProfile?
  businessMemberships BusinessMember[]
  // adCampaigns     AdCampaign[] // Deprecated
  
  // Relations from Monetization
  monetizationProfile MonetizationProfile?
  subscriptions       Subscription[] // As a subscriber

  reportsSubmitted Report[]       @relation("UserReports")
  
  // Relations from Lists
  ownedLists      List[]
  listMemberships ListMember[]
  followedLists   ListFollower[]
  
  // Relations from Messaging
  conversations    Participant[]
  sentMessages     Message[]
  messageReactions MessageReaction[]
  hiddenMessages   HiddenMessage[]
  conversationSettings ConversationUserSetting[]
  
  // Relations from Communities & Spaces
  communityMemberships  CommunityMember[]
  moderatedCommunities  CommunityModerator[]
  hostedSpaces          Space[]
  verificationRequests  VerificationRequest[]
  
  // Relations from Institutional
  institutionalProfile InstitutionalProfile?

  // Relations from Enterprise
  enterpriseUser      EnterpriseUser?
  enterpriseAlertRules EnterpriseAlertRule[]
}

model InstitutionalProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  
  // 1. Basic Institution Information
  institutionName String
  institutionType String   // e.g., "government", "ministry", "central_bank", etc.
  country         String?
  state           String?
  website         String?
  officialEmailDomain String?
  description     String?  @db.Text
  logoUrl         String?
  bannerUrl       String?
  
  // 2. Authorized Representative Details
  repFullName     String?
  repJobTitle     String?
  repDepartment   String?
  repOfficialEmail String?
  repPhone        String?
  repIdUrl        String?  // URL to government/work ID
  repLinkedInUrl  String?
  repAuthLetterUrl String? // URL to authorization letter
  
  // 3. Account Credentials & Access Control
  twoFactorEnabled Boolean @default(false)
  primaryRole      String  @default("publisher") // publisher, editor, viewer, admin
  recoveryEmail    String?
  recoveryPhone    String?

  // 4. Verification & Trust Information
  isVerified      Boolean  @default(false)
  isDomainVerified Boolean @default(false)
  supportingDocs  Json?    // Array of URLs or metadata
  transparencyAccepted Boolean @default(false)
  termsAccepted      Boolean @default(false)
  
  // 4. Public Profile Settings
  publicDisplayName String?
  publicBio         String?  @db.Text
  headquarters      String?
  categories        Json?    // Array of categories: ["Economy", "Health", etc.]
  languages         Json?    // Array of languages
  
  // 5. Admin Review Fields
  status          String   @default("pending") // pending, under_review, approved, rejected
  adminNotes      String?  @db.Text
  badgeType       String?  // official, sovereign, emergency
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  worldLeaders    WorldLeader[]
  announcements   Announcement[]
}

model WorldLeader {
  id              String   @id @default(uuid())
  institutionId   String
  leaderName      String
  title           String
  profileImage    String?
  region          String
  country         String
  priorityRank    Int      @default(0)
  autoPushEnabled Boolean  @default(false)
  verifiedStatus  Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  institution     InstitutionalProfile @relation(fields: [institutionId], references: [id], onDelete: Cascade)
}

model EnterpriseUser {
  id                String   @id @default(uuid())
  organizationName  String
  userId            String   @unique
  subscriptionTier  String   @default("standard") // standard, premium, elite
  apiAccessEnabled  Boolean  @default(false)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EnterpriseAlertRule {
  id                String   @id @default(uuid())
  userId            String
  categories        Json?    // ["Markets", "Economy"]
  regions           Json?    // ["North America", "Europe"]
  severityThreshold Int      @default(0)
  impactThreshold   Int      @default(50)
  keywords          Json?    // ["inflation", "rates"]
  deliveryMethod    String   @default("web") // web, email, webhook
  
  createdAt         DateTime @default(now())
  
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs              EnterpriseAlertLog[]
}

model EnterpriseAlertLog {
  id                String   @id @default(uuid())
  ruleId            String
  signalId          String
  triggeredAt       DateTime @default(now())
  deliveryStatus    String   @default("pending") // pending, sent, failed
  
  rule              EnterpriseAlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  signal            MarketSignal        @relation(fields: [signalId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
}

model Profile {
  id          String   @id @default(uuid())
  userId      String   @unique
  name        String
  handle      String   @unique
  bio         String?
  avatar      String?
  banner      String?
  location    String?
  website     String?
  birthdate   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  verified    Boolean  @default(false)
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([handle])
}

// --- Content & Social Models ---

model Post {
  id          String   @id @default(uuid())
  userId      String
  content     String
  mediaUrls   String? // JSON array of media URLs (Legacy/User Service compatibility)
  scheduledAt DateTime? // When set, post is hidden until this time
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  replyTo     Post?    @relation("PostReplies", fields: [replyToId], references: [id], onDelete: Cascade)
  replyToId   String?
  replies     Post[]   @relation("PostReplies")
  
  media           PostMedia[]

  likes       Like[]
  retweets    Retweet[]
  bookmarks   Bookmark[]
  notifications Notification[]
  communityPosts CommunityPost[]
  highlightedIn Highlight[]
  
  isPinned       Boolean         @default(false)
  productId      String?
  product        Product?        @relation(fields: [productId], references: [id])
  ctaLink        String?
  ctaLabel       String?

  @@index([userId, createdAt(sort: Desc)])
  @@index([replyToId])
  @@index([createdAt])
  @@index([scheduledAt])
}

model PostMedia {
  id              String   @id @default(uuid())
  postId          String
  mediaType       String   // "image" | "video"
  mediaUrl        String
  thumbnailUrl    String?  // video only
  width           Int
  height          Int
  duration        Float?   // video only
  size            Int
  createdAt       DateTime @default(now())
  
  post            Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model Like {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model Retweet {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model Bookmark {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   // recipient
  type      String   // 'like', 'retweet', 'follow', 'reply', 'mention'
  actorId   String   // user who triggered the notification
  postId    String?  // related post if applicable
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  
  user  User  @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor User  @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  post  Post? @relation(fields: [postId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([actorId])
  @@index([createdAt])
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  
  follower  User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)
  @@unique([followerId, followingId])
}

model Trend {
  id        String   @id @default(uuid())
  category  String   // e.g. "trending", "news", "sports", "entertainment"
  topic     String
  posts     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([category])
  @@index([createdAt])
}

// Messaging Models
model Conversation {
  id            String    @id @default(uuid())
  type          String    @default("direct") // direct, group
  updatedAt     DateTime  @updatedAt
  lastMessageAt DateTime  @default(now())

  // Basic caching for list view
  lastMessageId String?   @unique
  lastMessage   Message?  @relation("LastMessage", fields: [lastMessageId], references: [id])
  
  participants Participant[]
  messages     Message[] @relation("ConversationMessages")
  settings     ConversationUserSetting[]
}

model ConversationUserSetting {
  id                String       @id @default(uuid())
  conversationId    String
  userId            String
  disappearingMode  String       @default("off") // off, 1h, 24h, 7d
  blockScreenshots  Boolean      @default(false)
  blockMessages     Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
}

model Participant {
  id             String       @id @default(uuid())
  userId         String
  conversationId String
  lastReadAt     DateTime     @default(now())
  
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id])
  
  @@unique([userId, conversationId])
  @@index([userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  content        String?
  type           String       @default("text") // text, image, video, system
  mediaUrl       String?
  thumbnailUrl   String?
  duration       Int?         // in seconds
  size           Int?         // in bytes
  mimeType       String?
  status         String       @default("sent") // sent, delivered, read
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  
  conversation   Conversation @relation("ConversationMessages", fields: [conversationId], references: [id], onDelete: Cascade)
  isLastMessageFor Conversation? @relation("LastMessage")
  sender         User         @relation(fields: [senderId], references: [id])
  
  // New fields for Reply, Forward, and Edit
  replyToId      String?
  isForwarded    Boolean      @default(false)
  forwardedFromId String?
  isEdited       Boolean      @default(false)
  editedAt       DateTime?
  
  replyTo        Message?     @relation("MessageReplies", fields: [replyToId], references: [id])
  replies        Message[]    @relation("MessageReplies")
  
  reactions      MessageReaction[]
  hiddenBy       HiddenMessage[]
  
  @@index([conversationId])
  @@index([createdAt])
  @@index([senderId])
}

model HiddenMessage {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
}

model MessageReaction {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
}

// Communities & Spaces Models
model Community {
  id            String   @id @default(uuid())
  name          String
  description   String
  avatar        String?
  banner        String?
  membersCount  String   // Stored as string like "125K"
  rules         Json?    // Array of rule strings
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  members       CommunityMember[]
  posts         CommunityPost[]
  moderators    CommunityModerator[]
  
  @@index([createdAt])
}

model CommunityMember {
  id          String    @id @default(uuid())
  userId      String
  communityId String
  joinedAt    DateTime  @default(now())
  
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  
  @@unique([userId, communityId])
  @@index([userId])
  @@index([communityId])
}

model CommunityModerator {
  id          String    @id @default(uuid())
  userId      String
  communityId String
  
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  
  @@unique([userId, communityId])
  @@index([userId])
  @@index([communityId])
}

model CommunityPost {
  id          String    @id @default(uuid())
  communityId String
  postId      String
  
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  post        Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  
  @@unique([communityId, postId])
  @@index([communityId])
}

model Space {
  id          String   @id @default(uuid())
  title       String
  hostId      String
  topics      String[]
  privacy     String   @default("public") // public, private
  status      String   @default("live")   // live, scheduled, ended
  isLive      Boolean  @default(false)
  time        String?  // Legacy compatibility
  scheduledAt DateTime?
  startedAt   DateTime?
  endedAt     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  host      User     @relation(fields: [hostId], references: [id], onDelete: Cascade)
  
  @@index([hostId])
  @@index([isLive])
  @@index([status])
}

// --- Business & Ads Models ---

// --- Business & Ads Models ---

model BusinessProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  companyName     String
  industry        String?
  location        String?
  website         String?
  onboardingCompleted Boolean  @default(false)
  
  // Verification & Status
  isVerified      Boolean  @default(false)
  verificationDoc String?  // URL to doc
  status          String   @default("pending") // pending, approved, rejected
  
  // Analytics Snapshot
  totalSpent      String   @default("0")
  totalImpressions String  @default("0")
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  adAccounts      AdAccount[]
  members         BusinessMember[]
  products        Product[]
  reviews         BusinessReview[]
  ctas            BusinessCTA[]
}

model Product {
  id          String          @id @default(uuid())
  businessId  String
  name        String
  description String?
  price       Float?
  currency    String          @default("USD")
  imageUrl    String?
  ctaUrl      String?
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  business    BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  posts       Post[]

  @@index([businessId])
}

model BusinessReview {
  id          String          @id @default(uuid())
  businessId  String
  userId      String
  rating      Int
  comment     String?
  createdAt   DateTime        @default(now())
  business    BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model BusinessCTA {
  id          String          @id @default(uuid())
  businessId  String
  type        String          // e.g., "shop", "book", "contact", "subscribe"
  label       String
  url         String
  createdAt   DateTime        @default(now())
  business    BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model BusinessMember {
  id              String   @id @default(uuid())
  businessId      String
  userId          String
  role            String   @default("member") // owner, admin, member
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  business        BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([businessId, userId])
}

model AdAccount {
  id              String   @id @default(uuid())
  businessId      String
  status          String   @default("active") // active, suspended
  currency        String   @default("USD")
  balance         Float    @default(0.0)
  paymentMethod   String?  // card, upi
  paymentDetails  String?  // JSON
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  business        BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  campaigns       Campaign[]
}

model Campaign { // Renamed from AdCampaign for clarity
  id              String   @id @default(uuid())
  adAccountId     String
  name            String
  type            String   // "awareness", "traffic", "engagement", "sales"
  status          String   @default("draft") // draft, active, paused, completed, archived
  
  // Budget & Schedule
  dailyBudget     Float
  totalBudget     Float?
  startTime       DateTime
  endTime         DateTime?
  
  // Targeting (JSON)
  targeting       String?  // { locations: [], ageRange: [18, 65], interests: [] }
  
  // Metrics
  impressions     Int      @default(0)
  clicks          Int      @default(0)
  spend           Float    @default(0.0)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  adAccount       AdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  ads             Ad[]
}

model Ad {
  id              String   @id @default(uuid())
  campaignId      String   @map("campaign_id")
  name            String   @map("ad_name")
  status          String   @default("active")  // active, paused
  
  // Creative
  adType          String   @map("ad_type")      // image, video, text
  primaryText     String   @map("primary_text")
  headline        String?  @map("headline")
  mediaUrl        String?  @map("media_url")
  thumbnailUrl    String?  @map("thumbnail_url")
  ctaType         String?  @map("cta_type")      // LEARN_MORE, INSTALL, SIGN_UP, etc.
  destinationUrl  String?  @map("destination_url")
  
  // Metrics
  impressions     Int      @default(0)
  clicks          Int      @default(0)
  spend           Float    @default(0.0)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  campaign        Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

// --- Monetization Models ---

model MonetizationProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  status          String   @default("pending") // pending, approved, rejected, suspended
  
  // Financials
  balance         Float    @default(0.0)
  lifetimeEarnings Float   @default(0.0)
  payoutMethod    String?  // "stripe", "paypal"
  payoutDetails   String?  // JSON
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tiers           SubscriptionTier[]
  transactions    Transaction[]
}

model SubscriptionTier {
  id                    String   @id @default(uuid())
  monetizationProfileId String
  name                  String   // e.g. "Silver Fan", "Gold Member"
  description           String?
  price                 Float
  perks                 String?  // JSON array of strings
  isActive              Boolean  @default(true)
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  monetizationProfile   MonetizationProfile @relation(fields: [monetizationProfileId], references: [id], onDelete: Cascade)
  subscriptions         Subscription[]
}

model Subscription {
  id              String   @id @default(uuid())
  tierId          String
  subscriberId    String   // The user who is subscribing
  status          String   @default("active") // active, cancelled, expired
  
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  tier            SubscriptionTier @relation(fields: [tierId], references: [id], onDelete: Cascade)
  subscriber      User             @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  transactions    Transaction[]
}

model Transaction {
  id                    String   @id @default(uuid())
  monetizationProfileId String?  // Receiver (Creator)
  subscriptionId        String?  // If related to a sub
  type                  String   // "subscription_payment", "tip", "payout"
  amount                Float
  currency              String   @default("USD")
  status                String   @default("completed") // pending, completed, failed
  
  processorId           String?  // Stripe Payment ID
  
  createdAt             DateTime @default(now())
  
  monetizationProfile   MonetizationProfile? @relation(fields: [monetizationProfileId], references: [id])
  subscription          Subscription?        @relation(fields: [subscriptionId], references: [id])
}

// --- Lists Models ---

model List {
  id              String   @id @default(uuid())
  ownerId         String
  name            String
  description     String?
  isPrivate       Boolean  @default(false)
  banner          String?  // Optional banner/cover image
  avatar          String?  // Optional list profile/thumbnail image
  isPinned        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  owner           User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members         ListMember[]
  followers       ListFollower[]
  
  @@index([ownerId])
}

model ListMember {
  id              String   @id @default(uuid())
  listId          String
  userId          String
  addedAt         DateTime @default(now())
  
  list            List     @relation(fields: [listId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([listId, userId])
  @@index([listId])
  @@index([userId])
}

model ListFollower {
  id              String   @id @default(uuid())
  listId          String
  userId          String
  followedAt      DateTime @default(now())
  /// Pinned for this follower only (List.isPinned is owner-global)
  isPinned        Boolean  @default(false)

  list            List     @relation(fields: [listId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([listId, userId])
  @@index([listId])
  @@index([userId])
}

model AuditLog {
  id         String   @id @default(uuid())
  adminId    String
  action     String   // e.g., "CREATE_API_KEY", "UPDATE_PUSH_CONFIG"
  targetType String?
  targetId   String?
  details    String?  // JSON string
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([createdAt])
}

model Report {
  id         String   @id @default(uuid())
  type       String   @default("report")
  targetId   String
  targetType String
  reporterId String
  reason     String?
  status     String   @default("pending")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  reporter   User     @relation("UserReports", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([targetId])
  @@index([reporterId])
  @@index([status])
}

model VerificationRequest {
  id         String   @id @default(uuid())
  userId     String
  businessId String?
  type       String   @default("INDIVIDUAL") // INDIVIDUAL, BUSINESS, INSTITUTION
  status     String   @default("PENDING")    // PENDING, APPROVED, REJECTED
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
}

model ApiKey {
  id          String    @id @default(uuid())
  name        String
  keyHash     String    @unique
  keyPrefix   String    // First 8 chars for identification
  environment String    @default("dev") // dev, staging, prod
  scopes      String[]  // ["users:read", "posts:write", etc]
  rateLimit   Int       @default(100)
  status      String    @default("active") // active, disabled, revoked
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([keyHash])
}

model PushConfig {
  id           String   @id @default(uuid())
  provider     String   // FCM, APNS
  credentials  String   // Encrypted JSON string
  enabled      Boolean  @default(true)
  allowedTypes String[] // ["likes", "mentions", "replies", "direct_messages", "system"]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model BroadcastNotification {
  id          String   @id @default(uuid())
  title       String
  message     String
  targetType  String   @default("all") // all, specific_roles
  authorId    String
  status      String   @default("sent") // pending, sent, failed
  metrics     String?  // JSON: { delivered: Int, failures: Int }
  createdAt   DateTime @default(now())
}

model PushTemplate {
  id        String   @id @default(uuid())
  name      String   @unique
  title     String
  body      String
  category  String   @default("system")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Announcement {
  id                    String    @id @default(uuid())
  institutionId         String    // Link to InstitutionalProfile in User Service
  title                 String
  content               String    @db.Text
  category              String    // Markets, Health, Conflict, Policy, etc.
  severityLevel         Int       @default(1) // 1 to 5
  regions               Json      // Array of strings: ["Global", "Country", etc.]
  attachments           Json      // Array of {url, type, name}
  livestreamUrl         String?
  effectiveDate         DateTime  @default(now())
  expiryDate            DateTime?
  lockDurationMinutes   Int       @default(0)
  aiSummary             String?   @db.Text
  immutableHash         String    @unique // SHA256 of title + content + institutionId
  status                String    @default("draft") // draft, published, archived
  
  // World Leaders Module extensions
  isWorldLeaderPost     Boolean   @default(false)
  leaderId              String?   // ID reference to WorldLeader in User Service (No strict FK cross-service)
  leaderPriorityScore   Int       @default(0)
  isLive                Boolean   @default(false)
  transcriptUrl         String?
  speechVideoUrl        String?
  importanceScore       Float?    // Future AI scoring
 
  institution           InstitutionalProfile @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  createdBy             String    // User ID
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  revisions             AnnouncementRevision[]
  translations          AnnouncementTranslation[]
  marketSignals         MarketSignal[]
  comments              StructuredComment[]
  crisisId              String?
  crisis                CrisisEvent? @relation(fields: [crisisId], references: [id], onDelete: SetNull)
}

model MarketSignal {
  id              String   @id @default(uuid())
  announcementId  String
  institutionId   String
  category        String
  region          String
  sector          String?
  severity        Int
  impactScore     Int
  volatilityIndex Float?
  confidenceScore Int
  detectedKeywords Json?
  createdAt       DateTime @default(now())

  announcement    Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  alertLogs       EnterpriseAlertLog[]
}

model AnnouncementTranslation {
  id              String   @id @default(uuid())
  announcementId  String
  languageCode    String   // 'en', 'es', 'fr', 'ar', 'hi', etc.
  title           String
  content         String   @db.Text
  status          String   @default("pending") // pending, completed, failed
  aiModelUsed     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  announcement    Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([announcementId, languageCode])
}

model AnnouncementRevision {
  id              String   @id @default(uuid())
  announcementId  String
  version         Int
  editedBy        String
  changes         Json     // Object containing changed fields
  timestamp       DateTime @default(now())

  announcement    Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
}

// -----------------------------------------------------------------------------
// Structured Comments & Moderation Queue (Enterprise / Locked Discussion)
// -----------------------------------------------------------------------------

model StructuredComment {
  id                String   @id @default(uuid())
  announcementId    String
  userId            String   // Validated against authenticated / verified User
  parentCommentId   String?  // Nullable to allow up to depth 3 threading
  content           String
  factFlag          Boolean  @default(false)
  credibilityScore  Int?
  moderationStatus  String   @default("pending") // pending, approved, rejected
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  announcement      Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  parent            StructuredComment? @relation("CommentToComment", fields: [parentCommentId], references: [id], onDelete: SetNull)
  replies           StructuredComment[] @relation("CommentToComment")
  moderationQueue   CommentModerationQueue[]
  reports           CommentReport[]
}

model CommentModerationQueue {
  id            String   @id @default(uuid())
  commentId     String
  reviewerId    String?  // Admin/Mod ID
  reviewStatus  String   @default("pending") // pending, approved, rejected
  notes         String?
  reviewedAt    DateTime?
  createdAt     DateTime @default(now())

  comment       StructuredComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
}

model CommentReport {
  id          String   @id @default(uuid())
  commentId   String
  reporterId  String   // User ID
  reason      String
  status      String   @default("open")
  createdAt   DateTime @default(now())

  comment     StructuredComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
}

// -----------------------------------------------------------------------------
// Crisis Command & Real-time Monitoring
// -----------------------------------------------------------------------------

model CrisisEvent {
  id                    String         @id @default(uuid())
  title                 String
  description           String         @db.Text
  region                String
  country               String
  latitude              Float
  longitude             Float
  severity              Int            @default(1) // 1-5
  status                String         @default("active") // active, monitoring, resolved
  linkedAnnouncementIds String[]       @default([])
  startTime           DateTime       @default(now())
  lastUpdateTime      DateTime       @default(now()) @updatedAt
  createdBy             String
  createdAt             DateTime       @default(now())
  
  updates               CrisisUpdate[]
  streams               CrisisStream[]
  announcements         Announcement[]
}

model CrisisUpdate {
  id              String      @id @default(uuid())
  crisisId        String
  announcementId  String?
  updateText      String      @db.Text
  timestamp       DateTime    @default(now())
  createdBy       String
  
  crisis          CrisisEvent @relation(fields: [crisisId], references: [id], onDelete: Cascade)
}

model CrisisStream {
  id        String      @id @default(uuid())
  crisisId  String
  streamUrl String
  platform  String
  isLive    Boolean     @default(true)
  startedAt DateTime    @default(now())
  crisis    CrisisEvent @relation(fields: [crisisId], references: [id], onDelete: Cascade)
}

// -----------------------------------------------------------------------------
// Soapbox Mode (Structured Timed Statements System)
// -----------------------------------------------------------------------------

model SoapboxSession {
  id                String            @id @default(uuid())
  institutionId     String
  leaderId          String?
  title             String
  description       String            @db.Text
  startTime         DateTime
  durationMinutes   Int
  countdownEndTime  DateTime?
  status            String            @default("scheduled") // scheduled, live, completed, archived
  transcriptText    String?           @db.Text
  aiSummary         String?           @db.Text
  videoUrl          String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  statements        SoapboxStatement[]
  rebuttals         SoapboxRebuttal[]
}

model SoapboxStatement {
  id            String         @id @default(uuid())
  sessionId     String
  speakerId     String
  content       String         @db.Text
  timestamp     DateTime       @default(now())
  sequenceOrder Int

  session       SoapboxSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model SoapboxRebuttal {
  id                String         @id @default(uuid())
  sessionId         String
  institutionId     String
  userId            String
  rebuttalText      String         @db.Text
  moderationStatus  String         @default("pending") // pending, approved, rejected
  submittedAt       DateTime       @default(now())

  session           SoapboxSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

// -----------------------------------------------------------------------------
// Global Debate Framework System
// -----------------------------------------------------------------------------

model DebateSession {
  id                    String    @id @default(uuid())
  title                 String
  topic                 String
  participantAId        String    // Link to InstitutionalProfile or User
  participantBId        String    // Link to InstitutionalProfile or User
  moderatorId           String?   // Optional moderator
  startTime             DateTime?
  endTime               DateTime?
  roundDurationMinutes  Int       @default(5)
  totalRounds           Int       @default(3)
  status                String    @default("scheduled") // scheduled, live, completed, archived
  transcriptText        String?   @db.Text
  aiSummary             String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  rounds                DebateRound[]
  votes                 DebateVote[]
}

model DebateRound {
  id              String         @id @default(uuid())
  sessionId       String
  roundNumber     Int
  speakerId       String
  startTime       DateTime?
  endTime         DateTime?
  status          String         @default("pending") // pending, active, completed

  session         DebateSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  arguments       DebateArgument[]

  @@unique([sessionId, roundNumber, speakerId])
}

model DebateArgument {
  id              String         @id @default(uuid())
  roundId         String
  speakerId       String
  argumentText    String         @db.Text
  timestamp       DateTime       @default(now())
  factCheckRefs   Json?          // Array of { title: string, url: string }
  createdAt       DateTime       @default(now())

  round           DebateRound    @relation(fields: [roundId], references: [id], onDelete: Cascade)
  factChecks      DebateFactCheck[]
}

model DebateFactCheck {
  id                  String         @id @default(uuid())
  argumentId          String
  referenceTitle      String
  referenceUrl        String?
  reviewerId          String?
  verificationStatus  String         @default("pending") // pending, verified, disputed
  notes               String?        @db.Text

  argument            DebateArgument @relation(fields: [argumentId], references: [id], onDelete: Cascade)
}

model DebateVote {
  id              String         @id @default(uuid())
  sessionId       String
  userId          String
  voteChoice      String         // participant_a, participant_b, inconclusive
  submittedAt     DateTime       @default(now())

  session         DebateSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
}

// -----------------------------------------------------------------------------
// Highlights & Articles System
// -----------------------------------------------------------------------------

model Highlight {
  id          String   @id @default(uuid())
  userId      String
  postId      String
  createdAt   DateTime @default(now())
  orderIndex  Int      @default(0)

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
}

model Article {
  id            String   @id @default(uuid())
  userId        String
  title         String
  content       String   @db.Text
  coverImage    String?
  isPublished   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}
