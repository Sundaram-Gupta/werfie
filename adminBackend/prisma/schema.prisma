// This is your Prisma schema file
// X-Clone Master Schema (Unified)

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  role          String   @default("USER")
  institutionType String?
  status        String   @default("ACTIVE")
  banReason     String?
  banExpiresAt  DateTime?
  lastActiveAt  DateTime @default(now())
  preferredLanguage String @default("en")
  reputation    Int      @default(100) // 0-100 score
  
  refreshTokens RefreshToken[]
  profile       Profile?
  
  // Relations from Content/Social
  posts         Post[]
  likes         Like[]
  retweets      Retweet[]
  followers     Follow[]     @relation("UserFollowers")
  following     Follow[]     @relation("UserFollowing")
  notifications Notification[] @relation("NotificationRecipient")
  triggeredNotifications Notification[] @relation("NotificationActor")
  
  // Relations from Business & Ads
  businessProfile BusinessProfile?
  businessMemberships BusinessMember[]
  // adCampaigns     AdCampaign[] // Deprecated
  
  // Relations from Monetization
  monetizationProfile MonetizationProfile?
  subscriptions       Subscription[] // As a subscriber

  reportsSubmitted Report[]       @relation("UserReports")
  appealsSubmitted Appeal[]       @relation("UserAppeals")
  
  // Relations from Lists
  ownedLists      List[]
  listMemberships ListMember[]
  followedLists   ListFollower[]
  
  // Relations from Messaging
  conversations Participant[]
  messagesSent  Message[]
  
  // Relations from Communities & Spaces
  communityMemberships  CommunityMember[]
  moderatedCommunities  CommunityModerator[]
  hostedSpaces          Space[]
  verificationRequests  VerificationRequest[]
  institutionalProfile  InstitutionalProfile?
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
}

model Profile {
  id          String   @id @default(uuid())
  userId      String   @unique
  name        String
  handle      String   @unique
  bio         String?
  avatar      String?
  banner      String?
  location    String?
  website     String?
  birthdate   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  verified    Boolean  @default(false)
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([handle])
}

// --- Content & Social Models ---

model Post {
  id          String   @id @default(uuid())
  userId      String
  content     String
  mediaUrls   String? // JSON array of media URLs (Legacy/User Service compatibility)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  replyTo     Post?    @relation("PostReplies", fields: [replyToId], references: [id], onDelete: Cascade)
  replyToId   String?
  replies     Post[]   @relation("PostReplies")
  
  media           PostMedia[]

  likes       Like[]
  retweets    Retweet[]
  notifications Notification[]
  communityPosts CommunityPost[]
  
  @@index([userId])
  @@index([replyToId])
  @@index([createdAt])
}

model PostMedia {
  id              String   @id @default(uuid())
  postId          String
  mediaType       String   // "image" | "video"
  mediaUrl        String
  thumbnailUrl    String?  // video only
  width           Int
  height          Int
  duration        Float?   // video only
  size            Int
  aiFlagged       Boolean  @default(false)
  aiReason        String?
  aiScore         Float?
  createdAt       DateTime @default(now())
  
  post            Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model Like {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model Retweet {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   // recipient
  type      String   // 'like', 'retweet', 'follow', 'reply', 'mention'
  actorId   String   // user who triggered the notification
  postId    String?  // related post if applicable
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  
  user  User  @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor User  @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  post  Post? @relation(fields: [postId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([actorId])
  @@index([createdAt])
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  
  follower  User @relation("UserFollowers", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)
  @@unique([followerId, followingId])
}

model Trend {
  id        String   @id @default(uuid())
  category  String   // e.g. "trending", "news", "sports", "entertainment"
  topic     String
  posts     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([category])
  @@index([createdAt])
}

// Messaging Models
model Conversation {
  id            String    @id @default(uuid())
  type          String    @default("direct") // direct, group
  updatedAt     DateTime  @updatedAt
  lastMessageAt DateTime  @default(now())

  // Basic caching for list view
  lastMessageId String?   @unique
  lastMessage   Message?  @relation("LastMessage", fields: [lastMessageId], references: [id])
  
  participants Participant[]
  messages     Message[] @relation("ConversationMessages")
}

model Participant {
  id             String       @id @default(uuid())
  userId         String
  conversationId String
  lastReadAt     DateTime     @default(now())
  
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id])
  
  @@unique([userId, conversationId])
  @@index([userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  content        String?
  type           String       @default("text") // text, image, video, system
  mediaUrl       String?
  thumbnailUrl   String?
  duration       Int?         // in seconds
  size           Int?         // in bytes
  mimeType       String?
  status         String       @default("sent") // sent, delivered, read
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  
  conversation   Conversation @relation("ConversationMessages", fields: [conversationId], references: [id], onDelete: Cascade)
  isLastMessageFor Conversation? @relation("LastMessage")
  sender         User         @relation(fields: [senderId], references: [id])
  
  @@index([conversationId])
  @@index([createdAt])
  @@index([senderId])
}

// Communities & Spaces Models
model Community {
  id            String   @id @default(uuid())
  name          String
  description   String
  avatar        String?
  banner        String?
  membersCount  String   // Stored as string like "125K"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  members       CommunityMember[]
  posts         CommunityPost[]
  moderators    CommunityModerator[]
  
  @@index([createdAt])
}

model CommunityMember {
  id          String    @id @default(uuid())
  userId      String
  communityId String
  joinedAt    DateTime  @default(now())
  
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  
  @@unique([userId, communityId])
  @@index([userId])
  @@index([communityId])
}

model CommunityModerator {
  id          String    @id @default(uuid())
  userId      String
  communityId String
  
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  
  @@unique([userId, communityId])
  @@index([userId])
  @@index([communityId])
}

model CommunityPost {
  id          String    @id @default(uuid())
  communityId String
  postId      String
  
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  post        Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  
  @@unique([communityId, postId])
  @@index([communityId])
}

model Space {
  id          String   @id @default(uuid())
  title       String
  hostId      String
  topics      String[]
  privacy     String   @default("public") // public, private
  status      String   @default("live")   // live, scheduled, ended
  isLive      Boolean  @default(false)
  time        String?  // Legacy compatibility
  scheduledAt DateTime?
  startedAt   DateTime?
  endedAt     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  host      User     @relation(fields: [hostId], references: [id], onDelete: Cascade)
  
  @@index([hostId])
  @@index([isLive])
  @@index([status])
}

// --- Business & Ads Models ---

// --- Business & Ads Models ---

model BusinessProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  companyName     String
  industry        String?
  location        String?
  website         String?
  
  // Verification & Status
  isVerified      Boolean  @default(false)
  verificationDoc String?  // URL to doc
  status          String   @default("pending") // pending, approved, rejected
  
  // Analytics Snapshot
  totalSpent      String   @default("0")
  totalImpressions String  @default("0")
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  adAccounts      AdAccount[]
  members         BusinessMember[]
}

model BusinessMember {
  id              String   @id @default(uuid())
  businessId      String
  userId          String
  role            String   @default("member") // owner, admin, member
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  business        BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([businessId, userId])
}

model AdAccount {
  id              String   @id @default(uuid())
  businessId      String
  status          String   @default("active") // active, suspended
  currency        String   @default("USD")
  balance         Float    @default(0.0)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  business        BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  campaigns       Campaign[]
}

model Campaign { // Renamed from AdCampaign for clarity
  id              String   @id @default(uuid())
  adAccountId     String
  name            String
  type            String   // "awareness", "traffic", "engagement", "sales"
  status          String   @default("draft") // draft, active, paused, completed, archived
  
  // Budget & Schedule
  dailyBudget     Float
  totalBudget     Float?
  startTime       DateTime
  endTime         DateTime?
  
  // Targeting (JSON)
  targeting       String?  // { locations: [], ageRange: [18, 65], interests: [] }
  
  // Metrics
  impressions     Int      @default(0)
  clicks          Int      @default(0)
  spend           Float    @default(0.0)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  adAccount       AdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  ads             Ad[]
}

model Ad {
  id              String   @id @default(uuid())
  campaignId      String
  name            String
  status          String   @default("active") // active, paused, rejected
  
  // Creative
  headline        String
  bodyText        String?
  primaryMediaUrl String   // Image or Video
  mediaType       String   // "image" | "video"
  linkUrl         String?
  ctaType         String   @default("LEARN_MORE")
  
  // Metrics
  impressions     Int      @default(0)
  clicks          Int      @default(0)
  spend           Float    @default(0.0)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  campaign        Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

// --- Monetization Models ---

model MonetizationProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  status          String   @default("pending") // pending, approved, rejected, suspended
  
  // Financials
  balance         Float    @default(0.0)
  lifetimeEarnings Float   @default(0.0)
  payoutMethod    String?  // "stripe", "paypal"
  payoutDetails   String?  // JSON
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tiers           SubscriptionTier[]
  transactions    Transaction[]
}

model SubscriptionTier {
  id                    String   @id @default(uuid())
  monetizationProfileId String
  name                  String   // e.g. "Silver Fan", "Gold Member"
  description           String?
  price                 Float
  perks                 String?  // JSON array of strings
  isActive              Boolean  @default(true)
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  monetizationProfile   MonetizationProfile @relation(fields: [monetizationProfileId], references: [id], onDelete: Cascade)
  subscriptions         Subscription[]
}

model Subscription {
  id              String   @id @default(uuid())
  tierId          String
  subscriberId    String   // The user who is subscribing
  status          String   @default("active") // active, cancelled, expired
  
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  tier            SubscriptionTier @relation(fields: [tierId], references: [id], onDelete: Cascade)
  subscriber      User             @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  transactions    Transaction[]
}

model Transaction {
  id                    String   @id @default(uuid())
  monetizationProfileId String?  // Receiver (Creator)
  subscriptionId        String?  // If related to a sub
  type                  String   // "subscription_payment", "tip", "payout"
  amount                Float
  currency              String   @default("USD")
  status                String   @default("completed") // pending, completed, failed
  
  processorId           String?  // Stripe Payment ID
  
  createdAt             DateTime @default(now())
  
  monetizationProfile   MonetizationProfile? @relation(fields: [monetizationProfileId], references: [id])
  subscription          Subscription?        @relation(fields: [subscriptionId], references: [id])
}

// --- Lists Models ---

model List {
  id              String   @id @default(uuid())
  ownerId         String
  name            String
  description     String?
  isPrivate       Boolean  @default(false)
  banner          String?  // Optional banner image
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  owner           User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members         ListMember[]
  followers       ListFollower[]
  
  @@index([ownerId])
}

model ListMember {
  id              String   @id @default(uuid())
  listId          String
  userId          String
  addedAt         DateTime @default(now())
  
  list            List     @relation(fields: [listId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([listId, userId])
  @@index([listId])
  @@index([userId])
}

model ListFollower {
  id              String   @id @default(uuid())
  listId          String
  userId          String
  followedAt      DateTime @default(now())
  
  list            List     @relation(fields: [listId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([listId, userId])
  @@index([listId])
  @@index([userId])
}

model AuditLog {
  id         String   @id @default(uuid())
  adminId    String
  action     String   // e.g., "CREATE_API_KEY", "UPDATE_PUSH_CONFIG"
  targetType String?
  targetId   String?
  details    String?  // JSON string
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([createdAt])
}

model Report {
  id         String   @id @default(uuid())
  type       String   @default("report")
  targetId   String
  targetType String
  reporterId String
  reason     String?
  status     String   @default("pending")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  severity   Int      @default(1) // 1-10
  isAutomated Boolean @default(false)
  metadata   Json?    // AI logs, spam markers
  reporter   User     @relation("UserReports", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([targetId])
  @@index([reporterId])
  @@index([status])
}

model Appeal {
  id         String   @id @default(uuid())
  type       String   @default("Account Suspension") // standard appeal types
  reason     String?
  targetId   String?  // Id of post, comment or null if account
  status     String   @default("Pending") // Pending, Approved, Rejected
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  userId     String
  user       User     @relation("UserAppeals", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model VerificationRequest {
  id        String   @id @default(uuid())
  userId    String
  status    String   @default("pending") // pending, approved, rejected
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
}

model InstitutionalProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  
  institutionName String
  institutionType String
  country         String?
  state           String?
  website         String?
  officialEmailDomain String?
  description     String?
  logoUrl         String?
  bannerUrl       String?
  
  repFullName     String?
  repJobTitle     String?
  repDepartment   String?
  repOfficialEmail String?
  repPhone        String?
  repIdUrl        String?
  repLinkedInUrl  String?
  repAuthLetterUrl String?
  
  // Missing fields from user-service
  twoFactorEnabled     Boolean       @default(false)
  primaryRole          String        @default("publisher")
  recoveryEmail        String?
  recoveryPhone        String?
  isVerified           Boolean       @default(false)
  isDomainVerified     Boolean       @default(false)
  supportingDocs       Json?
  transparencyAccepted Boolean       @default(false)
  termsAccepted        Boolean       @default(false)
  publicDisplayName    String?
  publicBio            String?
  headquarters         String?
  categories           Json?
  languages            Json?

  status          String   @default("pending") // pending, under_review, approved, rejected
  adminNotes      String?
  badgeType       String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}


model ApiKey {
  id          String    @id @default(uuid())
  name        String
  keyHash     String    @unique
  keyPrefix   String    // First 8 chars for identification
  environment String    @default("dev") // dev, staging, prod
  scopes      String[]  // ["users:read", "posts:write", etc]
  rateLimit   Int       @default(100)
  status      String    @default("active") // active, disabled, revoked
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([keyHash])
}

model PushConfig {
  id           String   @id @default(uuid())
  provider     String   // FCM, APNS
  credentials  String   // Encrypted JSON string
  enabled      Boolean  @default(true)
  allowedTypes String[] // ["likes", "mentions", "replies", "direct_messages", "system"]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model BroadcastNotification {
  id          String   @id @default(uuid())
  title       String
  message     String
  targetType  String   @default("all") // all, specific_roles
  authorId    String
  status      String   @default("sent") // pending, sent, failed
  metrics     String?  // JSON: { delivered: Int, failures: Int }
  createdAt   DateTime @default(now())
}

model PushTemplate {
  id        String   @id @default(uuid())
  name      String   @unique
  title     String
  body      String
  category  String   @default("system")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
