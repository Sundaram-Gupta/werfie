{
    "info": {
        "_postman_id": "werfie-admin-backend-v1",
        "name": "Werfie Admin Backend",
        "description": "Postman collection for Werfie Admin Panel API (Next.js App Router). Includes Auth, User Management, Content Moderation, and System Config.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:3040/api/admin",
            "type": "string"
        }
    ],
    "item": [
        {
            "name": "Auth",
            "item": [
                {
                    "name": "Admin Login",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "var jsonData = pm.response.json();",
                                    "if (jsonData.success && jsonData.token) {",
                                    "    pm.environment.set(\"authToken\", jsonData.token);",
                                    "    pm.environment.set(\"adminId\", jsonData.user.id);",
                                    "    console.log(\"Token stored successfully\");",
                                    "}",
                                    "pm.test(\"Status code is 200\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"email\": \"admin@example.com\",\n    \"password\": \"admin\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/login",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "login"
                            ]
                        },
                        "description": "authenticate as admin to get JWT token."
                    },
                    "response": []
                }
            ]
        },
